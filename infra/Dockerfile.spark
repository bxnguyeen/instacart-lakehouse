FROM apache/spark:4.1.3-scala2.13-java17-python3-r-ubuntu

USER root

ADD https://repo.maven.apache.org/maven2/org/apache/iceberg/iceberg-spark-runtime-4.1_2.13/1.11.0/iceberg-spark-runtime-4.1_2.13-1.11.0.jar /opt/spark/jars/
ADD https://repo.maven.apache.org/maven2/org/apache/iceberg/iceberg-aws-bundle/1.11.0/iceberg-aws-bundle-1.11.0.jar /opt/spark/jars/
RUN chmod 644 /opt/spark/jars/iceberg-*.jar

RUN python3 -m pip install --no-cache-dir \
    --target /opt/ingest-deps \
    boto3==1.43.75

ENV PYTHONPATH="/opt/ingest-deps"

COPY spark/load_bronze_batch.py /opt/jobs/load_bronze_batch.py
COPY spark/load_catalog.py /opt/jobs/load_catalog.py
USER spark