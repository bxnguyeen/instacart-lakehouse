# MinIO user must match MINIO_ROOT_USER in infra/compose.yaml.
MINIO_ACCESS_KEY=lakehouse
MINIO_SECRET_KEY=REPLACE_WITH_A_LOCAL_PASSWORD

# Generate new keys for a fresh installation.
FERNET_KEY=REPLACE_WITH_A_GENERATED_FERNET_KEY
AIRFLOW__API_AUTH__JWT_SECRET=REPLACE_WITH_A_GENERATED_RANDOM_SECRET
AIRFLOW_UID=50000

# Local Airflow login.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=REPLACE_WITH_A_LOCAL_PASSWORD
